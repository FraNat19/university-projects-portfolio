# Copy to .env and fill in. Never commit the filled version.
#
#   cp .env.example .env
#   set -a && source .env && set +a

# Hugging Face access token, for gated models and the inference API.
# Create one at https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=

# Neo4j, the knowledge graph holding laws, articles and their relations.
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Qdrant, the vector store holding document and article embeddings.
QDRANT_URL=http://127.0.0.1:6333

# Ollama, serving the generation model.
OLLAMA_URL=http://127.0.0.1:11434
